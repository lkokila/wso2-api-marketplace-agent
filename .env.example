# Copy to .env and adjust. .env is git-ignored.
APIM_HOME=/path/to/wso2am-4.7.0
APIM_MGT_URL=https://localhost:9443
APIM_GW_URL=https://localhost:8243
APIM_ADMIN_USER=admin
APIM_ADMIN_PASSWORD=admin

# Devportal MCP server (created in the Publisher by mcp-server/scripts/provision.sh)
MCP_SERVER_NAME=DevportalMCP
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_CONTEXT=/devportal-mcp
# Header carrying the agent application's gateway token. The user's own token
# travels in `Authorization` and is passed through to the Devportal REST API.
MCP_GATEWAY_AUTH_HEADER=X-Agent-Authorization
# Devportal application the agent uses to subscribe to the MCP server
AGENT_APP_NAME=DevportalAgent

# Optional overrides (defaults shown)
# AGENT_PORT=9090
# UI_ORIGIN=http://localhost:5173

# Developer account used by the smoke test (created by create-test-user.sh)
TEST_USER=dev1
TEST_USER_PASSWORD=Dev1@spike123
